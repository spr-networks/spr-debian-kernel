Subject: [PATCH] builddeb: include Raspberry Pi overlay README

raspi-firmware's existing kernel postinst hook copies overlays/README
alongside the device trees. dtbs_install only installs DTB and DTBO files,
so include the README in the image package to let that hook complete.

diff --git a/scripts/package/builddeb b/scripts/package/builddeb
--- a/scripts/package/builddeb
+++ b/scripts/package/builddeb
@@ -39,6 +39,10 @@ install_linux_image () {
 	# Only some architectures with OF support have this target
 	if is_enabled CONFIG_OF_EARLY_FLATTREE && [ -d "${srctree}/arch/${SRCARCH}/boot/dts" ]; then
 		${MAKE} -f ${srctree}/Makefile INSTALL_DTBS_PATH="${pdir}/usr/lib/linux-image-${KERNELRELEASE}" dtbs_install
+		if [ -f "${srctree}/arch/${SRCARCH}/boot/dts/overlays/README" ]; then
+			install -D -m 644 "${srctree}/arch/${SRCARCH}/boot/dts/overlays/README" \
+				"${pdir}/usr/lib/linux-image-${KERNELRELEASE}/overlays/README"
+		fi
 	fi
 
 	${MAKE} -f ${srctree}/Makefile INSTALL_MOD_PATH="${pdir}" INSTALL_MOD_STRIP=1 modules_install
