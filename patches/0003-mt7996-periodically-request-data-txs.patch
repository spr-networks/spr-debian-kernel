Subject: wifi: mt76: mt7996: periodically request data TX status

Request a host TX status report on an ordinary unicast data frame roughly
every 250 ms per transmit WCID. This follows the sampling approach used by
mt7915, but keeps management, null, multicast, no-ACK and minimum-rate
frames from consuming the sampling interval.

Do this after link/WCID selection and before allocating the packet ID.
The existing TX path then provides a host TXD even for 802.3 offloaded
frames, and the existing TXS/completion path updates both wcid->rate and
mac80211's last_rate_info. No firmware command or new rate decoder is
needed. Idle stations generate no traffic solely for sampling.

Use cmpxchg to let only one concurrent TX queue claim an interval. Start
with an expired interval so the first eligible frame is sampled. A lost
report or failed packet-ID allocation can be retried at the next interval;
no permanent outstanding-request state is introduced.

--- a/drivers/net/wireless/mediatek/mt76/mt7996/mt7996.h
+++ b/drivers/net/wireless/mediatek/mt76/mt7996/mt7996.h
@@ -20,6 +20,7 @@
 					 mt7996_max_interface_num(dev))
 
 #define MT7996_WATCHDOG_TIME		(HZ / 10)
+#define MT7996_TXS_INTERVAL		(HZ / 4)
 #define MT7996_RESET_TIMEOUT		(30 * HZ)
 
 #define MT7996_TX_RING_SIZE		2048
@@ -228,6 +229,7 @@
 	struct ewma_avg_signal avg_ack_signal;
 
 	unsigned long changed;
+	unsigned long last_txs_request;
 
 	struct mt76_connac_sta_key_conf bip;
 
--- a/drivers/net/wireless/mediatek/mt76/mt7996/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7996/main.c
@@ -1029,6 +1029,7 @@
 	msta_link->wcid.link_id = link_id;
 	msta_link->wcid.link_valid = !!sta->valid_links;
 	msta_link->wcid.def_wcid = &msta->deflink.wcid;
+	msta_link->last_txs_request = jiffies - MT7996_TXS_INTERVAL;
 
 	ewma_avg_signal_init(&msta_link->avg_ack_signal);
 	ewma_signal_init(&msta_link->wcid.rssi);
--- a/drivers/net/wireless/mediatek/mt76/mt7996/mac.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7996/mac.c
@@ -3,6 +3,7 @@
  * Copyright (C) 2022 MediaTek Inc.
  */
 
+#include <linux/atomic.h>
 #include <linux/etherdevice.h>
 #include <linux/timekeeping.h>
 #include "coredump.h"
@@ -1066,6 +1067,46 @@
 	return false;
 }
 
+static void
+mt7996_tx_request_rate_status(struct mt76_wcid *wcid, struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct mt7996_sta_link *msta_link;
+	unsigned long now, last;
+	const u8 *dest;
+
+	if (!wcid->sta ||
+	    info->flags & (IEEE80211_TX_CTL_NO_ACK |
+			   IEEE80211_TX_CTL_USE_MINRATE) ||
+	    skb->protocol == cpu_to_be16(ETH_P_PAE))
+		return;
+
+	if (info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) {
+		struct ethhdr *hdr = (struct ethhdr *)skb->data;
+
+		dest = hdr->h_dest;
+	} else {
+		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+
+		if (!ieee80211_is_data_present(hdr->frame_control))
+			return;
+		dest = hdr->addr1;
+	}
+
+	if (is_multicast_ether_addr(dest))
+		return;
+
+	msta_link = container_of(wcid, struct mt7996_sta_link, wcid);
+	now = jiffies;
+	last = READ_ONCE(msta_link->last_txs_request);
+	if (time_before(now, last + MT7996_TXS_INTERVAL))
+		return;
+
+	/* TX queues can race; request at most one extra report per interval. */
+	if (cmpxchg(&msta_link->last_txs_request, last, now) == last)
+		info->flags |= IEEE80211_TX_CTL_REQ_TX_STATUS;
+}
+
 int mt7996_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 			  enum mt76_txq_id qid, struct mt76_wcid *wcid,
 			  struct ieee80211_sta *sta,
@@ -1164,6 +1205,7 @@
 	}
 
 	wcid = mt7996_get_tx_wcid(wcid);
+	mt7996_tx_request_rate_status(wcid, tx_info->skb);
 
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
 	memset(txwi_ptr, 0, MT_TXD_SIZE);
